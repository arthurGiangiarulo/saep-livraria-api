# Conexão com o SEU Postgres local (o mesmo que você abre no DBeaver).
# Copie para .env:  cp .env.example .env
# e ajuste DB_USER / DB_PASSWORD para as credenciais do seu Postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres        # usuário do seu Postgres (o padrão costuma ser "postgres")
DB_PASSWORD=postgres    # a senha que você definiu ao instalar o Postgres
DB_NAME=livraria        # o banco que você cria no DBeaver
